<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_it_asset_return_wizard_form" model="ir.ui.view">
        <field name="name">it.asset.return.wizard.form</field>
        <field name="model">it.asset.return.wizard</field>
        <field name="arch" type="xml">
            <form string="Return IT Assets">
                <group>
                    <group>
                        <field name="date_returned"/>
                        <field name="reason"/>
                    </group>
                    <group>
                        <field name="condition"/>
                        <field name="next_state"/>
                    </group>
                </group>
                <field name="asset_ids" options="{'no_create': True}">
                    <list>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="serial_no"/>
                        <field name="employee_id" string="Current Holder"/>
                        <field name="assigned_date"/>
                    </list>
                </field>
                <field name="note" placeholder="Return note (missing accessories, damages, etc.)"/>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm Return" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
