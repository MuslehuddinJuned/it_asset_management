<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_it_asset" model="ir.module.category">
        <field name="name">IT Asset Management</field>
        <field name="description">Access rights for IT Asset Management</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_it_asset_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_it_asset"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can view, create, assign and return IT assets.</field>
    </record>

    <record id="group_it_asset_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_it_asset"/>
        <field name="implied_ids" eval="[(4, ref('group_it_asset_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Full access including categories and deletion.</field>
    </record>

    <!-- Portal: lets a PORTAL user fully manage IT assets from /my/it-assets.
         Kept in its own category and without implied internal groups, so it
         can be given to portal users. Toggle it on the user form
         ("IT Asset Portal Manager"). -->
    <record id="module_category_it_asset_portal" model="ir.module.category">
        <field name="name">IT Asset Portal</field>
        <field name="sequence">21</field>
    </record>

    <record id="group_it_asset_portal_manager" model="res.groups">
        <field name="name">IT Asset Portal Manager</field>
        <field name="category_id" ref="module_category_it_asset_portal"/>
        <field name="comment">Portal users in this group can add, edit, assign, re-assign and
return IT assets, and create assets from Purchase Orders, from the customer portal.</field>
    </record>

    <!-- Multi-company rules -->
    <record id="it_asset_company_rule" model="ir.rule">
        <field name="name">IT Asset: multi-company</field>
        <field name="model_id" ref="model_it_asset"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="it_asset_assignment_company_rule" model="ir.rule">
        <field name="name">IT Asset Assignment: multi-company</field>
        <field name="model_id" ref="model_it_asset_assignment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
