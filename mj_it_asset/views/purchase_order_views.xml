<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_it_asset" model="ir.ui.view">
        <field name="name">purchase.order.form.it.asset</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_create_it_assets" type="object" string="Create IT Assets"
                        invisible="state not in ('purchase', 'done')"
                        groups="mj_it_asset.group_it_asset_manager"/>
            </xpath>
            <div name="button_box" position="inside">
                <button name="action_view_it_assets" type="object" class="oe_stat_button"
                        icon="fa-laptop" invisible="it_asset_count == 0"
                        groups="mj_it_asset.group_it_asset_user">
                    <field name="it_asset_count" widget="statinfo" string="IT Assets"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
