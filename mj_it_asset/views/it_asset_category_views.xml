<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_it_asset_category_tree" model="ir.ui.view">
        <field name="name">it.asset.category.tree</field>
        <field name="model">it.asset.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="asset_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_it_asset_category_form" model="ir.ui.view">
        <field name="name">it.asset.category.form</field>
        <field name="model">it.asset.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_assets" type="object" class="oe_stat_button" icon="fa-laptop">
                            <field name="asset_count" widget="statinfo" string="Assets"/>
                        </button>
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="active" invisible="1"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_it_asset_category" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">it.asset.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
